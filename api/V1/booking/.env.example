DATABASE_URL=sqlite:///./booking.db

VEHICLES_SERVICE_URL=http://localhost:9000/vehicles
PRICING_SERVICE_URL=http://localhost:9000/pricing
PAYMENT_SERVICE_URL=http://localhost:9000/payment
# Vrai service : PAYMENT_SERVICE_URL=https://payment-xp8n.onrender.com
# Clé fournie par l'équipe Payment (en-tête X-API-Key). Ne jamais la commiter.
PAYMENT_API_KEY=

# Bus d'événements (CloudAMQP) vers Messages/Notification. Laisser vide en dev
# si tu n'as pas besoin de publier de vrais événements : Booking retombe alors
# sur un simple log (voir app/adapters/outbound/messaging/event_publishers.py).
CLOUDAMQP_URL=
EVENT_BUS_EXCHANGE=microservice-event-bus
