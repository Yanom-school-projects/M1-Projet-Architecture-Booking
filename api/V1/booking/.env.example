DATABASE_URL=sqlite:///./booking.db

# Services URLs
VEHICLES_SERVICE_URL=https://parking-vehicles.onrender.com/
PRICING_SERVICE_URL=https://pricing-9khk.onrender.com
PAYMENT_SERVICE_URL=https://payment-xp8n.onrender.com
PARKING_SERVICE_URL=https://parking-6r73.onrender.com/

# Clés d'API SORTANTES (envoyées par Booking aux autres services)
VEHICLES_API_KEY=
PRICING_API_KEY=
PAYMENT_API_KEY=
PARKING_API_KEY=

# Clé d'API ENTRANTE de Booking (en-tête X-API-Key), partagée avec le front,
# Access et Prometheus. Vide = routes métier et /metrics refusées.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# TEMPORAIRE : true = si Vehicles ne répond pas, identifiant calculé par Booking (préfixe tmp-)
# Ignoré tant que VEHICLES_FALLBACK_SECRET est vide.
VEHICLES_FALLBACK_ENABLED=false
VEHICLES_FALLBACK_SECRET=


CLOUDAMQP_URL=
EVENT_BUS_EXCHANGE=microservice-event-bus

