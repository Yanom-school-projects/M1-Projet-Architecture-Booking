          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Taux d'erreur",
      "description": "Part des requêtes en erreur (4xx + 5xx) sur l'ensemble des requêtes de chaque service.",
