# Secrets de la stack locale (docker compose). Copier en .env (ignoré par Git)
# et remplacer chaque valeur, par exemple avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Clé d'API de Booking : attendue par l'API, envoyée par le front.
# Prometheus la lit dans monitoring/prometheus/secrets/booking_api_key.
API_KEY=a-remplacer

# Mot de passe du compte admin de Grafana.
GRAFANA_ADMIN_PASSWORD=a-remplacer
